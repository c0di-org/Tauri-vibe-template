{
  "name": "tauri-vibe-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "init": "node scripts/init-template.mjs",
    "doctor": "node scripts/template-doctor.mjs",
    "doctor:release": "node scripts/template-doctor.mjs --require-initialized --require-android",
    "android:prepare": "node scripts/prepare-android.mjs",
    "android:reset": "node scripts/prepare-android.mjs --fresh",
    "icons": "tauri icon assets/app-icon.svg",
    "deploy:devices": "bash scripts/deploy-local.sh",
    "deploy:devices:mac": "bash scripts/deploy-local.sh mac",
    "deploy:devices:android": "bash scripts/deploy-local.sh android",
    "version:sync": "node scripts/sync-version-from-tag.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "@types/node": "^26.4.0"
  }
}
